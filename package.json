{
  "name": "prism-assets",
  "version": "0.3.1",
  "private": true,
  "description": "Local-first visual asset library for artists",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "freeze": "PYINSTALLER_CONFIG_DIR=build/pyinstaller-cache .venv/bin/pyinstaller --noconfirm --distpath build/service --workpath build/pyinstaller prism-service.spec",
    "package": "npm run build && node scripts/package.cjs",
    "test:backend": ".venv/bin/python tests/integration.py",
    "test:governance": ".venv/bin/python tests/governance.py",
    "test:collections": ".venv/bin/python tests/collections.py",
    "test:models": ".venv/bin/python tests/models.py",
    "test:retry": ".venv/bin/python tests/retry.py",
    "test:retry-ui": "node tests/retry-ui.cjs",
    "test:appearance-ui": "node tests/appearance-ui.cjs",
    "test:ui": "node tests/ui.cjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^39.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
